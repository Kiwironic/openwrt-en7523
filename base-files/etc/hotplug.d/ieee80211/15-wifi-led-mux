#!/bin/sh
# Fix MT7916 WiFi LED GPIO mux on the EN7523 AX3000 router.
#
# The mt76 driver's mt7915_init_led_mux() writes to MT_LED_GPIO_MUX1
# (0x70005054) via the PCIe MMIO bus, but this register is outside the
# PCIe BAR mapping so the write silently fails.  The debugfs regidx/regval
# interface uses a different access path that can reach this register.
#
# Without this fix the WiFi LEDs (2.4 GHz + 5 GHz) never light up because
# the GPIO mux stays at 0x00000000.
#
# We set bits [31:24] = 0x33 which routes GPIO 14 and GPIO 15 on the
# MT7916 to the LED controller — the same value the driver uses in its
# DBDC branch.
[ "$ACTION" = "add" ] || exit 0
[ "$DEVICENAME" = "phy0" ] || exit 0

DBG=/sys/kernel/debug/ieee80211/phy0/mt76

# Wait for debugfs to appear
i=0
while [ ! -f "$DBG/regidx" ] && [ $i -lt 10 ]; do
	sleep 1
	i=$((i + 1))
done
[ -f "$DBG/regidx" ] || exit 0

# Set MT_LED_GPIO_MUX1 (0x70005054) = 0x33000000
echo 0x70005054 > "$DBG/regidx"
echo 0x33000000 > "$DBG/regval"

# The /etc/init.d/led script runs at boot (START=96) before the mt76
# driver registers its LEDs, so the netdev triggers from the uci config
# are never applied.  Reload the LED config now that the LEDs exist.
/etc/init.d/led restart 2>/dev/null

exit 0
