# Sensitive data — never commit
*dump*
*backup*
mtd[0-9]*
*nand_dump*
*secret*
*credential*
*password*

# Firmware blobs — no redistribution rights, extract from your own device
# (see docs/Firmware-Extraction.md)
firmware/*.bin
firmware/mediatek/*.bin

# Local-only device provisioning (per-device credentials, not for the repo)
local/

# Build artifacts
build/
bin/
tmp/
*.o
*.ko
*.cmd
.tmp_versions/

# Editor / OS files
.DS_Store
*~
*.swp
*.swo
*.orig
*.rej

# TFTP chunks (generated, not source)
chunks/
chunk[0-9]*

# Python cache
__pycache__/
*.pyc

# Lock files
*.lock
